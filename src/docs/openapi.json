{
  "openapi": "3.0.3",
  "info": {
    "title": "To-Do API",
    "version": "2.0.0",
    "description": "API REST para gerenciamento de tarefas com filtros, busca, paginação e estatísticas."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Tarefas"
    },
    {
      "name": "Sistema"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Status da API e do banco",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tarefas": {
      "get": {
        "tags": ["Tarefas"],
        "summary": "Lista tarefas",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["pendente", "em_andamento", "concluida"]
            }
          },
          {
            "name": "prioridade",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["baixa", "media", "alta"]
            }
          },
          {
            "name": "busca",
            "in": "query",
            "description": "Busca no título",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["createdAt", "updatedAt", "titulo", "prioridade", "dataLimite"],
              "default": "createdAt"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaTarefas"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tarefas"],
        "summary": "Cria uma tarefa",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarefa"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/tarefas/estatisticas": {
      "get": {
        "tags": ["Tarefas"],
        "summary": "Resumo por status e tarefas atrasadas",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tarefas/{id}": {
      "get": {
        "tags": ["Tarefas"],
        "summary": "Busca por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "665f1c2b8a1e4b6d2c3f4a5b"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarefa"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Tarefas"],
        "summary": "Atualiza (parcial)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "665f1c2b8a1e4b6d2c3f4a5b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarefa"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Tarefas"],
        "summary": "Atualiza (parcial)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "665f1c2b8a1e4b6d2c3f4a5b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tarefa"
                }
              }
            }
          },
          "400": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tarefas"],
        "summary": "Remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "665f1c2b8a1e4b6d2c3f4a5b"
          }
        ],
        "responses": {
          "204": {
            "description": "Removida"
          },
          "404": {
            "description": "Erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TarefaInput": {
        "type": "object",
        "required": ["titulo"],
        "properties": {
          "titulo": {
            "type": "string",
            "maxLength": 120,
            "example": "Estudar Node.js"
          },
          "descricao": {
            "type": "string",
            "maxLength": 1000,
            "example": "Revisar streams e eventos"
          },
          "status": {
            "type": "string",
            "enum": ["pendente", "em_andamento", "concluida"]
          },
          "prioridade": {
            "type": "string",
            "enum": ["baixa", "media", "alta"]
          },
          "dataLimite": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Tarefa": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titulo": {
            "type": "string",
            "maxLength": 120,
            "example": "Estudar Node.js"
          },
          "descricao": {
            "type": "string",
            "maxLength": 1000,
            "example": "Revisar streams e eventos"
          },
          "status": {
            "type": "string",
            "enum": ["pendente", "em_andamento", "concluida"]
          },
          "prioridade": {
            "type": "string",
            "enum": ["baixa", "media", "alta"]
          },
          "dataLimite": {
            "type": "string",
            "format": "date-time"
          },
          "concluidaEm": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ListaTarefas": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tarefa"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
